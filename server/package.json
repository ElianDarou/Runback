{
  "name": "runback-server",
  "version": "1.0.0",
  "private": true,
  "description": "Own Runback server: copy of your data, website, API and read-only SQL access.",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "start": "node dist/server.js",
    "dev": "tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "prebuild": "node generate-tokens.mjs",
    "predev": "node generate-tokens.mjs",
    "pretypecheck": "node generate-tokens.mjs",
    "pretest": "node generate-tokens.mjs"
  },
  "engines": {
    "node": ">=24.21"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3"
  }
}
